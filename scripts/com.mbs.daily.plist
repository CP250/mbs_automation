<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mbs.daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/cpreston/dev/mbs_automation/scripts/mbs_daily.sh</string>
    </array>

    <!-- Fire at 06:00 local time. If asleep at 06:00, launchd coalesces and runs on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Also run when the agent loads (login/boot) so a powered-off-overnight Mac still catches up.
         The script's per-day stamp prevents any double run. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/cpreston/.mbs_automation/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cpreston/.mbs_automation/launchd.err.log</string>
</dict>
</plist>
