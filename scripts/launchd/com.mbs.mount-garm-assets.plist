<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mbs.mount-garm-assets</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/cpreston/dev/mbs_automation/scripts/mount_garm_assets.sh</string>
    </array>

    <!-- hoest only. Every 60 seconds: if the share served by garm is not mounted and garm's SMB port answers, mount it. Silent otherwise. -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/cpreston/.mbs_automation/mount_garm_assets.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cpreston/.mbs_automation/mount_garm_assets.err.log</string>
</dict>
</plist>
