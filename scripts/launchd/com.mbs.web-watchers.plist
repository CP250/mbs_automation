<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mbs.web-watchers</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/cpreston/dev/mbs_automation/scripts/web_watchers.sh</string>
    </array>

    <!-- Daily 08:30 local. Mbs-daily fires at 06:00; oslo-weekly at 07:15 (Mon).
         08:30 puts the watcher comfortably after the morning report so any
         daily-note appends land after Vault Agent has finished writing. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <!-- Also run at login/boot; the outer per-day stamp prevents any double run. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/cpreston/.mbs_automation/web_watchers.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/cpreston/.mbs_automation/web_watchers.err.log</string>
</dict>
</plist>
